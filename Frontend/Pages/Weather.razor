@page "/students"
@using System.Text.Json
@inject RegistrationApiClient Api

<PageTitle>Students</PageTitle>

<h1>Students</h1>

@if (error is not null)
{
    <p role="alert">@error</p>
    <button class="btn btn-primary" @onclick="LoadStudentsAsync" disabled="@isBusy">Try again</button>
}
else if (students is null)
{
    <p>Loading students...</p>
}
else if (students.Count == 0)
{
    <p>No students yet.</p>
}
else
{
    <table class="table">
        <thead>
            <tr><th>Name</th><th>Neptun code</th><th>Email</th></tr>
        </thead>
        <tbody>
            @foreach (var student in students)
            {
                <tr @key="student.NeptunCode">
                    <td>@student.Name</td>
                    <td>@student.NeptunCode</td>
                    <td>@student.EmailAddress</td>
                </tr>
            }
        </tbody>
    </table>
}

@code {

    private IReadOnlyList<StudentDto>? students;

    private string? error;

    private bool isBusy;

    protected override Task OnInitializedAsync() => LoadStudentsAsync();

    private async Task LoadStudentsAsync()
    {
        if (isBusy)
        {
            return;
        }

        isBusy = true;
        error = null;
        students = null;

        try
        {
            students = await Api.GetAllStudentsAsync();
        }
        catch (Exception exception) when (exception is HttpRequestException or JsonException or InvalidDataException)
        {
            error = $"Could not load students. {exception.Message}";
        }
        finally
        {
            isBusy = false;
        }
    }
}