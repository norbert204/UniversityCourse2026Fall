@page "/students"
@using System.Text.Json
@inject RegistrationApiClient Api
@inject Microsoft.JSInterop.IJSRuntime JS

<PageTitle>Students</PageTitle>

<h1>Students</h1>

@if (_error is not null)
{
    <p role="alert">@_error</p>
    <button class="btn btn-primary" @onclick="LoadStudentsAsync" disabled="@_isBusy">Try again</button>
}

@if (_students is null && _error is null)
{
    <p>Loading students...</p>
}
else if (_students is { Count: 0 })
{
    <p>No students yet.</p>
}
else if (_students is not null)
{
    <div class="table-responsive">
        <table class="table">
            <thead>
                <tr><th>Name</th><th>Neptun code</th><th>Email</th><th>Actions</th></tr>
            </thead>
            <tbody>
                @foreach (var student in _students)
                {
                    <tr @key="student.NeptunCode">
                        <td>@student.Name</td>
                        <td>@student.NeptunCode</td>
                        <td>@student.EmailAddress</td>
                        <td>
                            <button class="btn btn-link text-danger p-0" type="button" @onclick="() => DeleteStudentAsync(student)" disabled="@_isBusy">Delete</button>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
}

@code {

    private IReadOnlyList<StudentDto>? _students;

    private string? _error;

    private bool _isBusy;

    protected override Task OnInitializedAsync() => LoadStudentsAsync();

    private async Task LoadStudentsAsync()
    {
        if (_isBusy)
        {
            return;
        }

        _isBusy = true;
        _error = null;
        _students = null;

        try
        {
            _students = await Api.GetAllStudentsAsync();
        }
        catch (Exception exception) when (exception is HttpRequestException or JsonException or InvalidDataException)
        {
            _error = $"Could not load students. {exception.Message}";
        }
        finally
        {
            _isBusy = false;
        }
    }

    private async Task DeleteStudentAsync(StudentDto studentToDelete)
    {
        if (_isBusy || _students is null)
        {
            return;
        }

        _isBusy = true;

        try
        {
            _error = null;
            await Api.DeleteStudentAsync(studentToDelete.NeptunCode);
            _students = _students.Where(student => student.NeptunCode != studentToDelete.NeptunCode).ToArray();
        }
        catch (HttpRequestException exception)
        {
            _error = $"Could not delete the student. {exception.Message}";
        }
        finally
        {
            _isBusy = false;
        }
    }
}