@page "/"
@using System.Text.Json
@inject RegistrationApiClient Api

<PageTitle>Student Portal</PageTitle>

<h1>Student Portal</h1>
<p>Add a student, then use the menu to see students and lessons.</p>

<h2>Add student</h2>

@if (_message is not null)
{
    <p role="status">@_message</p>
}
@if (_error is not null)
{
    <p role="alert">@_error</p>
}

<EditForm Model="_student" OnValidSubmit="AddStudentAsync">
    <DataAnnotationsValidator />
    <ValidationSummary />

    <div class="mb-3">
        <label for="student-name">Name</label>
        <InputText id="student-name" class="form-control" @bind-Value="_student.Name" />
    </div>
    <div class="mb-3">
        <label for="student-email">Email</label>
        <InputText id="student-email" type="email" class="form-control" @bind-Value="_student.EmailAddress" />
    </div>
    <div class="mb-3">
        <label for="student-birth-date">Date of birth</label>
        <InputDate id="student-birth-date" class="form-control" @bind-Value="_student.BirthDate" />
    </div>
    <button class="btn btn-primary" type="submit" disabled="@_isBusy">Add student</button>
</EditForm>

@code {

    private StudentForm _student = new();

    private string? _message;

    private string? _error;

    private bool _isBusy;

    private async Task AddStudentAsync()
    {
        if (_isBusy)
        {
            return;
        }

        _isBusy = true;
        _error = null;
        _message = null;

        try
        {
            await Api.AddStudentAsync(new AddStudentRequest
            {
                Name = _student.Name,
                EmailAddress = _student.EmailAddress,
                BirthDate = _student.BirthDate
            });
            _student = new StudentForm();
            _message = "Student added.";
        }
        catch (Exception exception) when (exception is HttpRequestException or JsonException or InvalidDataException)
        {
            _error = $"Could not add the student. {exception.Message}";
        }
        finally
        {
            _isBusy = false;
        }
    }

    private sealed class StudentForm
    {
        [Required]
        public string Name { get; set; } = string.Empty;

        [Required, EmailAddress]
        public string EmailAddress { get; set; } = string.Empty;

        public DateOnly BirthDate { get; set; } = DateOnly.FromDateTime(DateTime.Today.AddYears(-20));
    }
}
