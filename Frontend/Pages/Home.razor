@page "/"
@inject RegistrationApiClient Api

<PageTitle>Student Portal</PageTitle>

<h1>Student Portal</h1>
<p>Add a student, then use the menu to see students and lessons.</p>

<h2>Add student</h2>

@if (message is not null)
{
    <p role="status">@message</p>
}
@if (request.Error is not null)
{
    <p role="alert">@request.Error</p>
}

<EditForm Model="student" OnValidSubmit="AddStudentAsync">
    <DataAnnotationsValidator />
    <ValidationSummary />

    <div class="mb-3">
        <label for="student-name">Name</label>
        <InputText id="student-name" class="form-control" @bind-Value="student.Name" />
    </div>
    <div class="mb-3">
        <label for="student-email">Email</label>
        <InputText id="student-email" type="email" class="form-control" @bind-Value="student.EmailAddress" />
    </div>
    <div class="mb-3">
        <label for="student-birth-date">Date of birth</label>
        <InputDate id="student-birth-date" class="form-control" @bind-Value="student.BirthDate" />
    </div>
    <button class="btn btn-primary" type="submit" disabled="@request.IsBusy">Add student</button>
</EditForm>

@code {
    private StudentForm student = new();
    private string? message;
    private readonly RequestState request = new();

    private Task AddStudentAsync() =>
        request.RunAsync(async () =>
        {
            message = null;
            await Api.AddStudentAsync(new AddStudentRequest
            {
                Name = student.Name,
                EmailAddress = student.EmailAddress,
                BirthDate = student.BirthDate
            });
            student = new StudentForm();
            message = "Student added.";
        }, "Could not add the student.");

    private sealed class StudentForm
    {
        [Required]
        public string Name { get; set; } = string.Empty;

        [Required, EmailAddress]
        public string EmailAddress { get; set; } = string.Empty;

        public DateOnly BirthDate { get; set; } = DateOnly.FromDateTime(DateTime.Today.AddYears(-20));
    }
}
